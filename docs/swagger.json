{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API веб-мессенджера PingPong: регистрация и JWT-авторизация, личные и групповые чаты, сообщения с курсорной пагинацией и поиском, доставка в реальном времени через WebSocket.\n\n**Как авторизоваться:** выполните `POST /login`, нажмите **Authorize** и вставьте `Bearer \u003ctoken\u003e`.\n\n**Ошибки** возвращаются обычным текстом (`text/plain`), например `chat not found`. Если вы не участник чата, API отвечает 404, чтобы не раскрывать, что чат существует.",
        "title": "PingPong API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/chats": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Список чатов, в которых состоит текущий пользователь. У личных чатов `title` равен null.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Мои чаты",
                "responses": {
                    "200": {
                        "description": "Список чатов (может быть пустым)",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Chat"
                            }
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chats/direct": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Если личный чат с этим пользователем уже есть, возвращает его id со статусом 200. Иначе создаёт новый и отвечает 201. Чат с самим собой создать нельзя.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Личный чат: найти или создать",
                "parameters": [
                    {
                        "description": "id собеседника",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateDirectRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Чат уже существовал",
                        "schema": {
                            "$ref": "#/definitions/CreateChatResponse"
                        }
                    },
                    "201": {
                        "description": "Чат создан",
                        "schema": {
                            "$ref": "#/definitions/CreateChatResponse"
                        }
                    },
                    "400": {
                        "description": "Невалидный JSON или чат с самим собой",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "user not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chats/group": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Создаёт группу. Создатель автоматически становится участником с ролью `admin`.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Создать групповой чат",
                "parameters": [
                    {
                        "description": "Название группы (1–50 символов)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CreateGroupRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Группа создана",
                        "schema": {
                            "$ref": "#/definitions/CreateChatResponse"
                        }
                    },
                    "400": {
                        "description": "Невалидный JSON или название",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chats/{id}/members": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Добавляет пользователя в групповой чат. Доступно только админу чата. Если вы не участник чата, ответ 404.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "chats"
                ],
                "summary": "Добавить участника",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID чата",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "id добавляемого пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/AddMemberRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Участник добавлен"
                    },
                    "400": {
                        "description": "Невалидный id чата или JSON",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "only admin can add members",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "chat not found / user not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "user is already a member",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chats/{id}/members/{userID}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Удаляет пользователя из чата. Доступно только админу чата, удалить самого себя нельзя.",
                "tags": [
                    "chats"
                ],
                "summary": "Удалить участника",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID чата",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "ID удаляемого пользователя",
                        "name": "userID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Участник удалён"
                    },
                    "400": {
                        "description": "Невалидный id или cannot remove yourself",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "only admin can remove members",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "chat not found / member not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chats/{id}/messages": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Курсорная пагинация от новых к старым. Для следующей страницы передайте в `before` id самого старого сообщения из текущей.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "История сообщений",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID чата",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Вернуть сообщения с id меньше этого",
                        "name": "before",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Размер страницы: по умолчанию 50, максимум 100",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Страница сообщений",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Message"
                            }
                        }
                    },
                    "400": {
                        "description": "invalid before / invalid limit",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "chat not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Сохраняет сообщение в чате. Отправитель должен быть участником чата. Для доставки собеседникам в реальном времени используйте WebSocket `/ws`.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Отправить сообщение (HTTP)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID чата",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Текст сообщения (1–500 символов)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/SendMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Сообщение сохранено",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "400": {
                        "description": "message must be 1-500 symbols",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "chat not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chats/{id}/messages/search": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Ищет подстроку в сообщениях чата без учёта регистра. Возвращает до 50 последних совпадений.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Поиск по сообщениям",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID чата",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Текст для поиска (1–100 символов)",
                        "name": "q",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Найденные сообщения",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Message"
                            }
                        }
                    },
                    "400": {
                        "description": "query must be 1-100 symbols",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "chat not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Отвечает `{\"status\":\"OK\"}`, если сервер запущен.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Проверка состояния",
                "responses": {
                    "200": {
                        "description": "Сервер работает",
                        "schema": {
                            "$ref": "#/definitions/HealthResponse"
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "Проверяет email и пароль и выдаёт JWT (HS256, живёт 24 часа). Токен передаётся в заголовке `Authorization: Bearer \u003ctoken\u003e`.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Вход",
                "parameters": [
                    {
                        "description": "Email и пароль",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "JWT",
                        "schema": {
                            "$ref": "#/definitions/LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Невалидный JSON или данные",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid email or password",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Возвращает профиль владельца токена.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Текущий пользователь",
                "responses": {
                    "200": {
                        "description": "Профиль",
                        "schema": {
                            "$ref": "#/definitions/User"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "user not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Создаёт нового пользователя. Логин 3–25 символов, корректный email, пароль от 8 до 72 байт (ограничение bcrypt).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Регистрация",
                "parameters": [
                    {
                        "description": "Данные нового пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Пользователь создан",
                        "schema": {
                            "$ref": "#/definitions/RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Невалидный JSON или данные",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "user already exists",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/ws": {
            "get": {
                "description": "Открывает WebSocket. Swagger UI не умеет подключаться к WebSocket: проверяйте в Postman (New → WebSocket) или через фронтенд.\n\n**Подключение:** `ws://localhost:8080/ws?token=\u003cJWT\u003e`. Токен передаётся в query, потому что браузер не может ставить заголовки при открытии WebSocket.\n\n**Клиент → сервер:** `{\"chat_id\": 13, \"message\": \"Привет!\"}` (модель WSIncomingMessage).\n\n**Сервер → клиент:** сохранённое сообщение (модель WSOutgoingMessage) рассылается всем участникам чата, которые сейчас онлайн, включая отправителя. Для него это подтверждение доставки.\n\n**Ошибки** приходят только отправителю: `{\"error\": \"bad json\"}`, `{\"error\": \"invalid message\"}`, `{\"error\": \"chat not found\"}`, `{\"error\": \"internal error\"}`.",
                "tags": [
                    "realtime"
                ],
                "summary": "WebSocket: сообщения в реальном времени",
                "parameters": [
                    {
                        "type": "string",
                        "description": "JWT из /login",
                        "name": "token",
                        "in": "query",
                        "required": true
                    },
                    {
                        "description": "Формат сообщения клиента (отправляется по WebSocket, не в теле HTTP)",
                        "name": "message",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/WSIncomingMessage"
                        }
                    }
                ],
                "responses": {
                    "101": {
                        "description": "Соединение переключено на WebSocket; так выглядят входящие сообщения",
                        "schema": {
                            "$ref": "#/definitions/WSOutgoingMessage"
                        }
                    },
                    "401": {
                        "description": "invalid token",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "AddMemberRequest": {
            "type": "object",
            "properties": {
                "user_id": {
                    "type": "integer",
                    "example": 40
                }
            }
        },
        "Chat": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-10-22T12:00:00Z"
                },
                "id": {
                    "type": "integer",
                    "example": 13
                },
                "title": {
                    "type": "string",
                    "x-nullable": true,
                    "example": "Команда проекта"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "direct",
                        "group"
                    ],
                    "example": "group"
                }
            }
        },
        "CreateChatResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 13
                }
            }
        },
        "CreateDirectRequest": {
            "type": "object",
            "properties": {
                "user_id": {
                    "type": "integer",
                    "example": 39
                }
            }
        },
        "CreateGroupRequest": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "Команда проекта"
                }
            }
        },
        "HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "OK"
                }
            }
        },
        "LoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "kuroame@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "supersecret"
                }
            }
        },
        "LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
            }
        },
        "Message": {
            "type": "object",
            "properties": {
                "chat_id": {
                    "type": "integer",
                    "example": 13
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-10-28T18:34:54Z"
                },
                "id": {
                    "type": "integer",
                    "example": 120
                },
                "message": {
                    "type": "string",
                    "example": "Привет!"
                },
                "user_id": {
                    "type": "integer",
                    "example": 38
                }
            }
        },
        "RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 250,
                    "example": "kuroame@example.com"
                },
                "login": {
                    "type": "string",
                    "maxLength": 25,
                    "minLength": 3,
                    "example": "kuroame"
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8,
                    "example": "supersecret"
                }
            }
        },
        "RegisterResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 38
                }
            }
        },
        "SendMessageRequest": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "maxLength": 500,
                    "minLength": 1,
                    "example": "Привет!"
                }
            }
        },
        "User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-10-20T18:30:00Z"
                },
                "email": {
                    "type": "string",
                    "example": "kuroame@example.com"
                },
                "id": {
                    "type": "integer",
                    "example": 38
                },
                "login": {
